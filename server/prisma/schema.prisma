generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Pure information — NOT a login account. Admin maintains this as a staff
// directory (nurses, ward boys, cleaners, etc.) — no password, no Role, no
// auth involvement at all. Kept entirely separate from User on purpose.
model Employee {
  id                 String    @id @default(cuid())
  fullName           String
  designation        String // free text: "Nurse", "Ward Boy", "Cleaner", etc. — not an enum, so new job titles don't need a migration
  department         String? // free text: "OPD", "IPD", "Housekeeping", etc. — separate from designation (job title vs. team/section)
  phone              String?
  email              String?
  joiningDate        DateTime  @db.Date
  isActive           Boolean   @default(true)
  notes              String?
  shiftId            String?
  shift              Shift?    @relation(fields: [shiftId], references: [id])
  shiftEffectiveFrom DateTime? @db.Date // date the current shift starts applying
  shiftEffectiveTo   DateTime? @db.Date // optional end date; null = ongoing/indefinite

  // Salary/bank details — entirely optional. Directory records can exist
  // with none of this filled in; nothing here is required to create or
  // update an employee.
  salary        Float?
  bankName      String?
  ifscCode      String?
  bankAccountNo String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  salaries     EmployeeSalary[]
  shiftHistory ShiftAssignmentHistory[]
}

model EmployeeSalary {
  id         String @id @default(cuid())
  employeeId String
  month      Int // 1-12
  year       Int

  // Snapshot of Employee.salary at generation time. Editable per-month so a
  // raise or one-off change doesn't rewrite history for prior months.
  baseSalary Float
  totalDays  Int // calendar days in this month, e.g. 30/31/28

  // Auto-computed from the Attendance table for this employee + month.
  // PRESENT = 1 day, HALF_DAY = 0.5 day, ON_LEAVE / ABSENT counted below.
  presentDays Float @default(0)
  leaveDays   Float @default(0) // ON_LEAVE count
  absentDays  Float @default(0) // ABSENT count
  paidLeaves  Float @default(0)
  lopDays     Float @default(0)

  perDaySalary   Float @default(0) // = baseSalary / totalDays
  leaveDeduction Float @default(0) // auto = perDaySalary * lopDays, editable override

  // Manual, per-month additions/corrections.
  bonus           Float   @default(0)
  bonusReason     String?
  otherAdjustment Float   @default(0) // +/-, e.g. allowance, fine, advance recovery
  adjustmentNote  String?

  // netSalary = baseSalary - leaveDeduction + bonus + otherAdjustment
  netSalary Float @default(0)

  status        SalaryStatus @default(DRAFT)
  paidDate      DateTime?
  paymentMethod String?
  notes         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, year, month])
  @@map("employee_salaries")
}

enum SalaryStatus {
  DRAFT // generated, still editable, not yet finalized
  FINALIZED // admin has reviewed/locked the numbers, ready to pay
  PAID // payment has actually gone out
}

// One row per calendar date that isn't a normal working day beyond the
// weekly Sunday off — public holidays (national/govt) and company-declared
// holidays. Sundays are NOT stored here; they're derived from the date
// itself in the Working Days calendar/salary calculations. A date can only
// have one holiday entry (@@unique), so marking a date again edits it
// in place instead of creating a duplicate.
model Holiday {
  id        String      @id @default(cuid())
  date      DateTime    @db.Date
  name      String
  type      HolidayType @default(COMPANY)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@unique([date])
  @@map("holidays")
}

enum HolidayType {
  PUBLIC // national/govt holiday, e.g. Independence Day
  COMPANY // company-declared holiday
}

model User {
  id                     String                   @id @default(cuid())
  fullName               String
  email                  String                   @unique
  phone                  String                   @unique
  password               String
  role                   Role
  modules                Module[]                 @default([])
  isActive               Boolean                  @default(true)
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  notificationReads      NotificationRead[]
  shiftAssignmentChanges ShiftAssignmentHistory[]
}

model IPD_Patient {
  id           String  @id @default(cuid())
  serialNumber String  @unique
  name         String
  age          Int
  gender       String
  phone        String?
  aadhar       String?
  address      String?

  admissionDate DateTime
  admissionTime String
  expectedDays  Int?

  dischargeDate   DateTime?
  dischargeTime   String?
  status          String    @default("Admitted")
  dischargeStatus String    @default("Admitted")
  notes           String?

  // True when this admission was created via the OPD "Move to IPD" action
  // (see OPDPatient.moveToIPD) rather than a fresh IPD admission — drives
  // the "From OPD" badge/highlight in the IPD directory.
  fromOPD Boolean @default(false)

  followUpDate     DateTime?
  condition        PatientCondition?
  followUpDesc     String?
  followUpStatus   FollowUpStatus    @default(PENDING)
  reminderEnabled  Boolean           @default(false)
  reminderStatus   ReminderStatus    @default(NOT_SET)
  reminderSentDate DateTime?

  deposit          Float  @default(0)
  cash             Float  @default(0)
  upi              Float  @default(0)
  card             Float  @default(0)
  totalPaid        Float  @default(0)
  totalStay        Float  @default(0)
  balance          Float  @default(0)
  settlementStatus String @default("Pending")

  oil     Int @default(0)
  protein Int @default(0)
  syrup   Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dailyCharges      IPD_DailyCharge[]
  documents         IPD_Document[]
  medicines         IPD_Medicine[]
  payments          IPD_Payment[]
  additionalCharges IPD_AdditionalCharge[]

  @@map("ipd_patients")
}

model IPD_DailyCharge {
  id        String      @id @default(cuid())
  date      DateTime
  days      Float
  rate      Float
  amount    Float
  patientId String
  createdAt DateTime    @default(now())
  patient   IPD_Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@map("ipd_daily_charges")
}

// Flexible "add a charge section" — covers Dialysis, Doctor Consultation,
// Lab Tests, Consumables, Procedures, Other Services, etc. without needing
// a dedicated model + migration per category. `label` is free text (same
// pattern as Employee.designation elsewhere in this schema) so new charge
// types never need a schema change.
enum IpdChargeType {
  ONE_TIME
  PER_DAY
}

model IPD_AdditionalCharge {
  id         String        @id @default(cuid())
  patientId  String
  label      String // e.g. "Dialysis Charges", "Doctor Consultation", "Lab Tests"
  chargeType IpdChargeType @default(ONE_TIME)
  rate       Float // one-time amount, or the per-day rate when chargeType = PER_DAY
  // Snapshot of the day-count used to compute `amount` at save time (only
  // meaningful when chargeType = PER_DAY). Stored rather than recomputed
  // live so past invoices don't silently change if the patient's admission
  // or discharge date is edited later.
  days       Float         @default(0)
  amount     Float // = rate when ONE_TIME, = rate * days when PER_DAY
  createdAt  DateTime      @default(now())
  patient    IPD_Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@map("ipd_additional_charges")
}

model IPD_Medicine {
  id           String      @id @default(cuid())
  name         String
  quantity     Float
  unit         String      @default("Tablets")
  medicineId   String?
  dosage       String?
  frequency    String?
  duration     String?
  instructions String?
  patientId    String
  createdAt    DateTime    @default(now())
  medicine     medicine?   @relation(fields: [medicineId], references: [id])
  patient      IPD_Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@map("ipd_medicines")
}

model IPD_Payment {
  id              String        @id @default(cuid())
  amount          Float
  method          PaymentMethod
  referenceNumber String?
  notes           String?
  paymentDate     DateTime      @default(now())
  patientId       String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  patient         IPD_Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@map("ipd_payments")
}

model IPD_Document {
  id        String      @id @default(cuid())
  name      String
  type      String
  url       String
  fileType  String?
  patientId String
  createdAt DateTime    @default(now())
  patient   IPD_Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@map("ipd_documents")
}

model OPDPatient {
  id                  String               @id @default(cuid())
  tokenNumber         Int                  @unique @default(autoincrement())
  name                String
  age                 Int
  gender              Gender
  place               String?
  phone               String?
  fee                 Float                @default(0)
  cash                Float                @default(0)
  upi                 Float                @default(0)
  total               Float                @default(0)
  visitDate           DateTime             @db.Date
  notes               String?
  followUpDate        DateTime?            @db.Date
  condition           PatientCondition?
  followUpDesc        String?
  followUpStatus      FollowUpStatus       @default(PENDING)
  reminderEnabled     Boolean              @default(false)
  reminderStatus      ReminderStatus       @default(NOT_SET)
  reminderSentDate    DateTime?            @db.Date
  diagnosis           String?
  prescription        String?
  doctorNotes         String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  prescribedMedicines PrescribedMedicine[]
}

// Stores every invoice generated from the OPD/IPD "Generate Invoice" screens.
// patientType + patientId together point at either an OPDPatient or an
// IPD_Patient row. Kept as plain fields (no FK relation) since a single
// invoice can point at either table — this avoids needing two nullable
// relations and keeps invoice history intact even if a patient record is
// later removed.
model Invoice {
  id            String @id @default(cuid())
  invoiceNumber String @unique
  patientType   String // "OPD" | "IPD"
  patientId     String
  patientName   String

  lineItems     Json // [{ description, qty, rate, amount }]
  subtotal      Float
  discount      Float   @default(0)
  gstPercent    Float   @default(0)
  gstAmount     Float   @default(0)
  grandTotal    Float
  paid          Float   @default(0)
  balance       Float   @default(0)
  paymentMethod String?
  notes         String?

  // Staff member who generated this invoice. Kept as plain fields (not a
  // relation) for the same reason as patientId — history should survive
  // even if the user account is later deleted/deactivated.
  createdById   String?
  createdByName String?

  createdAt DateTime @default(now())

  @@index([patientType, patientId])
  @@map("invoices")
}

model Category {
  id        String     @id @default(cuid())
  name      String     @unique
  createdAt DateTime   @default(now())
  medicines medicine[]
}

// Which broad category of medicine/item this is — separate from `Category`
// (which is a free-text, admin-defined grouping like "Antibiotics" or "Pain
// Relief"). This is a fixed, clinic-wide classification used for filtering
// and reporting across the whole inventory. DB values unchanged (GENERIC /
// SURGICAL) — only the display labels changed (see pharmacy.mappers.js):
// GENERIC -> "General Medicine", SURGICAL -> "Surgical Medicine".
enum MedicineType {
  GENERIC // General / allopathic medicines (displayed as "General Medicine")
  AYURVEDIC // Ayurvedic medicines
  SURGICAL // Surgery-related items (displayed as "Surgical Medicine")
}

// Simplified inventory model: everything except id/timestamps is optional
// so a record can be created with as little as just a name. Packing was
// collapsed from a Box → Sheet → Tablet hierarchy down to a single
// Strip → Tablet hierarchy — purchasePrice/sellingPrice are now PER STRIP
// (previously per box).
model medicine {
  id            String        @id @default(cuid())
  serialNumber  String?       @unique
  drugName      String?
  genericName   String?
  categoryId    String?
  medicineType  MedicineType? @default(GENERIC)
  manufacturer  String?
  batchNumber   String?
  purchasePrice Float?        @default(0) // per strip
  sellingPrice  Float?        @default(0) // per strip

  // Strip → Tablet packing + stock, all optional/manual.
  totalStrips     Int?     @default(0) // how many strips purchased (manual entry)
  tabletsPerStrip Int?     @default(0) // how many tablets in one strip (manual entry)
  totalTablets    Int?     @default(0) // auto = totalStrips * tabletsPerStrip
  quantity        Int      @default(0) // current stock, always tracked in tablets
  initialQuantity Int      @default(0)
  reorderLevel    Int?     @default(0)
  purchaseDate    DateTime? @db.Date
  expiryDate      DateTime? @db.Date
  supplierName    String?
  notes           String?
  unitType        UnitType @default(TABLET)

  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  category            Category?            @relation(fields: [categoryId], references: [id])
  prescribedMedicines PrescribedMedicine[]
  stockHistory        StockHistory[]
  ipdMedicines        IPD_Medicine[]
}

model StockHistory {
  id              String      @id @default(cuid())
  medicineId      String
  date            DateTime    @db.Date
  action          StockAction
  quantity        Int
  reason          String
  unit            StockUnit?
  enteredQuantity Int?
  createdAt       DateTime    @default(now())
  medicine        medicine    @relation(fields: [medicineId], references: [id], onDelete: Cascade)
}

model PrescribedMedicine {
  id                 String     @id @default(cuid())
  opdPatientId       String
  medicineId         String
  quantity           Int
  dosageInstructions String?
  createdAt          DateTime   @default(now())
  medicine           medicine   @relation(fields: [medicineId], references: [id])
  opdPatient         OPDPatient @relation(fields: [opdPatientId], references: [id], onDelete: Cascade)
}

model NotificationRead {
  id     String   @id @default(cuid())
  userId String
  key    String
  readAt DateTime @default(now())
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
}

model LoginOtp {
  id         String   @id @default(cuid())
  identifier String
  otp        String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
}

model Otp {
  id         String   @id @default(cuid())
  identifier String
  otp        String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
}

enum Role {
  ADMIN
  DOCTOR
  RECEPTIONIST
  PHARMACY
  MANAGER
}

enum Module {
  OPD
  IPD
  PHARMACY
}

enum PaymentMethod {
  CASH
  UPI
  CARD
  BANK_TRANSFER
  OTHER
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum PatientCondition {
  STABLE
  IMPROVING
  CHRONIC
  MILD
  GOOD
  CRITICAL
}

enum FollowUpStatus {
  PENDING
  COMPLETED
  MISSED
}

enum ReminderStatus {
  NOT_SET
  PENDING
  SENT
  FAILED
}

enum StockAction {
  ADD
  REDUCE
  ADJUST
}

// Packing information: what kind of pack this medicine comes in.
enum UnitType {
  TABLET
  CAPSULE
  SYRUP
  INJECTION
  OINTMENT
  DROPS
  POWDER
  OTHER
}

// Which level of the Strip → Tablet hierarchy a stock update was entered
// in. Nullable on StockHistory so pre-existing rows (before this feature)
// remain valid. NOTE: previously had a third level (BOX); the Box/Sheet
// hierarchy was collapsed down to just Strip/Tablet — old rows with
// unit = BOX or SHEET will need a data migration/backfill if any exist.
enum StockUnit {
  STRIP
  TABLET
}

// BIOMETRIC ATTENDANCE MODULES

model BiometricDevice {
  id           String   @id @default(cuid())
  name         String
  deviceCode   String   @unique
  serialNumber String   @unique
  location     String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  mappings    BiometricMapping[]
  logs        BiometricLog[]
  attendances Attendance[]

  @@map("biometric_devices")
}

model BiometricMapping {
  id          String   @id @default(cuid())
  biometricId String   @unique // globally unique across all devices, per your instruction
  deviceId    String
  userId      String? // plain scalar — see note above, not a Prisma relation
  employeeId  String? // plain scalar — see note above, not a Prisma relation
  shiftId     String? // which Shift this person's attendance is calculated against; null = falls back to the implicit default day shift
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  device      BiometricDevice @relation(fields: [deviceId], references: [id])
  shift       Shift?          @relation(fields: [shiftId], references: [id])
  attendances Attendance[]

  @@map("biometric_mappings")
}

model BiometricLog {
  id           String    @id @default(cuid())
  deviceId     String
  deviceSerial String
  enrollmentId String
  punchTime    DateTime
  punchMode    PunchMode @default(UNKNOWN)
  rawData      Json
  isProcessed  Boolean   @default(false)
  createdAt    DateTime  @default(now())

  device BiometricDevice @relation(fields: [deviceId], references: [id])

  @@index([deviceId, enrollmentId, punchTime])
  @@map("biometric_logs")
}

model Attendance {
  id               String           @id @default(cuid())
  userId           String? // plain scalar — see note above, not a Prisma relation
  employeeId       String? // plain scalar — see note above, not a Prisma relation
  mappingId        String?
  deviceId         String?
  shiftId          String? // snapshot of which Shift was used to compute this day's metrics — kept even if the mapping's shift assignment changes later
  date             DateTime         @db.Date
  firstPunch       DateTime?
  lastPunch        DateTime?
  workingMinutes   Int              @default(0)
  lateMinutes      Int              @default(0)
  earlyExitMinutes Int              @default(0)
  overtimeMinutes  Int              @default(0)
  status           AttendanceStatus @default(ABSENT)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  mapping BiometricMapping? @relation(fields: [mappingId], references: [id])
  device  BiometricDevice?  @relation(fields: [deviceId], references: [id])
  shift   Shift?            @relation(fields: [shiftId], references: [id])

  @@unique([userId, employeeId, date])
  @@map("attendances")
}

enum PunchMode {
  IN
  OUT
  UNKNOWN
}

model Shift {
  id                   String    @id @default(cuid())
  name                 String
  code                 String    @unique
  type                 ShiftType @default(GENERAL)
  startTime            String // "HH:mm"
  endTime              String // "HH:mm" — <= startTime means overnight
  graceBeforeMinutes   Int       @default(0) // how early a punch-in still counts as on-time
  graceAfterMinutes    Int       @default(0) // how late a punch-in still counts as on-time
  breakMinutes         Int       @default(0) // unpaid break, subtracted from working hours
  overtimeAfterMinutes Int       @default(0) // buffer past shift end before extra time counts as OT
  totalWorkingMinutes  Int // derived: (end - start), overnight-adjusted, minus breakMinutes — stored so it doesn't need recomputing on every read
  description          String?
  isActive             Boolean   @default(true)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  mappings          BiometricMapping[]
  attendances       Attendance[]
  employees         Employee[]
  historyAsPrevious ShiftAssignmentHistory[] @relation("PreviousShiftHistory")
  historyAsNew      ShiftAssignmentHistory[] @relation("NewShiftHistory")

  @@map("shifts")
}

enum ShiftType {
  DAY
  NIGHT
  GENERAL
}

model ShiftAssignmentHistory {
  id              String    @id @default(cuid())
  employeeId      String
  previousShiftId String?
  newShiftId      String?
  effectiveFrom   DateTime? @db.Date // date this particular change starts applying
  effectiveTo     DateTime? @db.Date // optional end date; null = ongoing/indefinite
  changedById     String? // User.id of the admin who made the change; null if made by an automated process
  changedAt       DateTime  @default(now())

  employee      Employee @relation(fields: [employeeId], references: [id])
  previousShift Shift?   @relation("PreviousShiftHistory", fields: [previousShiftId], references: [id])
  newShift      Shift?   @relation("NewShiftHistory", fields: [newShiftId], references: [id])
  changedBy     User?    @relation(fields: [changedById], references: [id])

  @@map("shift_assignment_history")
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  ON_LEAVE
}
